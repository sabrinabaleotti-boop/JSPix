# Supabase (Project Settings > Database > Connection string)
# Transaction pooler (porta 6543) para a app:
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (porta 5432, IPv4) para migrations. Nao use db.xxx.supabase.co: e so IPv6 e o Render nao suporta.
DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo do JWT das sessoes (gere com: openssl rand -hex 32)
JWT_SECRET="troque-por-um-segredo-longo"

# Pagar.me (sk_test_... no sandbox). Se vazio, a app roda em modo simulado.
PAGARME_SECRET_KEY=""
PAGARME_ENV="test"

# Chave AES para cifrar segredos no banco (openssl rand -hex 32)
SECRETS_ENCRYPTION_KEY=""

# URL pública do app, usada para montar o webhook da Legacy (ex.: https://jspix.onrender.com).
# Se vazio, é deduzida dos cabeçalhos da requisição.
PUBLIC_URL=""

# Legacy Ecom (opcional; também dá para configurar no /admin). Só existem chaves de produção.
LEGACY_PUBLIC_KEY=""
LEGACY_SECRET_KEY=""
# Segredo whsec_ da assinatura de webhooks, se ativada no painel da Legacy
LEGACY_WEBHOOK_SECRET=""

# Web Push (aviso de Pix pago no celular/desktop). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu@email.com"

# Fuso usado nas datas do painel (o servidor fica nos EUA)
TZ="America/Sao_Paulo"
# Chave do endpoint /api/cron/reconcile (openssl rand -hex 24). Chame-o a cada minuto com cron-job.org ou similar.
CRON_SECRET=""
